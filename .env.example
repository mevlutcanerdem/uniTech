# Bu dosyayı .env olarak kopyala ve değerleri değiştir.
JWT_SECRET=buraya-uzun-rastgele-bir-deger-yaz
DJANGO_SECRET_KEY=buraya-baska-uzun-rastgele-bir-deger-yaz
# API ile arayüzün paylaştığı anahtar (iki servise de aynı değer).
INTERNAL_API_KEY=buraya-ucuncu-uzun-rastgele-bir-deger-yaz

# Bu e-postalarla kayıt olan hesaplar otomatik olarak yönetici olur (virgülle ayır).
ADMIN_EMAILS=ad.soyad@agu.edu.tr

# E-posta doğrulama ve şifre sıfırlama için birini doldur. Boş kalırsa doğrulama kapalı olur.
# Brevo (ücretsiz, günde 300 e-posta): https://www.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
MAIL_FROM=
# Veya kendi SMTP sunucun:
# SMTP_HOST=smtp.agu.edu.tr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Geliştirirken kodları gerçek e-posta yerine sunucu günlüğüne yaz:
# MAIL_DEV_LOG=1

# Yerelde çalışırken DEBUG açık kalabilir; sunucuda 0 yap.
DJANGO_DEBUG=1

# Sunucuya taşırken alan adına göre güncelle:
# DJANGO_ALLOWED_HOSTS=unitech.agu.edu.tr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://unitech.agu.edu.tr
# FRONTEND_ORIGIN=https://unitech.agu.edu.tr
# API_PUBLIC_URL=https://api.unitech.agu.edu.tr
